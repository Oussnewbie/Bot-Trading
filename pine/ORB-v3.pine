//@version=6
// ORB v3 — Cassure du range d'ouverture de New York (5 minutes)
// Graphique M5. Toutes les heures sont en heure de New York (9:30 NY = 15:30 à Paris la plupart de l'année).
//
// Règles :
//  1. Range    : high et low de la première bougie M5 de la séance (9:30-9:35).
//  2. Ordres   : à 9:35, un achat stop sur le high et une vente stop sur le low (le premier exécuté annule l'autre).
//                Ils restent valables 2 bougies (jusqu'à 9:45), puis ils sont annulés : pas de trade ce jour-là.
//  3. Stop     : de l'autre côté du range. 1R = la somme perdue si le stop est touché (taille × range).
//                Le résultat en R affiché = gain ou perte nets du trade (commission comprise) ÷ ce montant,
//                donc le même chiffre que dans le testeur de stratégie.
//                Le seuil du stop à l'entrée et l'objectif se mesurent depuis le prix d'exécution réel.
//  4. Gestion  : stop remonté au prix d'entrée dès +1,5R. Pas d'objectif par défaut : sortie à 15:45 (clôture à 15:50).
//  5. Un seul trade par jour. Risque conseillé : 0,5 % par trade.
//  Option : filtre RSI14 M5 (achat seulement si le RSI de 9:30 est au-dessus de 50, vente seulement en dessous ;
//           l'ordre est annulé si l'autre côté du range est touché d'abord).
//
// Test sur NAS100 CFD (Dukascopy, bid et ask, spread compté), mai 2018 → octobre 2026 : 2 091 trades,
// +0,114R par trade, pire baisse -32R, pire série 13 pertes, 8 années positives sur 9.
// Le testeur de TradingView ne compte pas le spread d'un CFD : ajoute une commission dans « Propriétés »
// pour un résultat réaliste.
strategy("ORB New York 5 min (v3)", shorttitle = "ORB v3", overlay = true,
     initial_capital = 10000, currency = currency.USD, pyramiding = 1,
     process_orders_on_close = true, margin_long = 0, margin_short = 0, slippage = 2,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ═════════════════════════ Paramètres ═════════════════════════
GR = "Risque"
riskPct   = input.float(0.5, "Risque par trade (% du capital)", minval = 0.1, step = 0.1, tooltip = "0,5 % conseillé : la pire série du test est de 13 pertes et la pire baisse de 32R (environ -15 % du capital à 0,5 %, -28 % à 1 %).", group = GR)
qtyStepIn = input.float(0, "Pas de taille (0 = auto)", minval = 0, step = 0.01, tooltip = "Taille minimale chez le broker, en unités TradingView. Auto : futures = 1 contrat, forex = 1000 unités, crypto = 0,0001, actions = 1, CFD = 0,01.", group = GR)

GS = "Horaires (heure de New York)"
orS       = input.session("0930-0935", "Bougie du range", tooltip = "La première bougie M5 de la séance de New York.", group = GS)
liveBars  = input.int(2, "Ordres valables (bougies après le range)", minval = 1, maxval = 24, tooltip = "2 = jusqu'à 9:45. Dans le test, les cassures plus tardives ne rapportaient rien.", group = GS)
flatS     = input.session("1545-1600", "Fermeture de fin de journée", tooltip = "La position est fermée à la clôture de la bougie de 15:45, soit 15:50.", group = GS)

GP = "Gestion du trade"
beR       = input.float(1.5, "Stop au prix d'entrée à partir de (R)", minval = 0, step = 0.25, tooltip = "0 = désactivé. 1,5 : même gain que sans, mais pire baisse de -48R à -32R dans le test. À +1R, il coûte du gain.", group = GP)
tgtR      = input.float(0, "Objectif (R)", minval = 0, step = 0.5, tooltip = "0 = pas d'objectif, sortie en fin de journée (le mieux dans le test). 5 = un peu moins de gain mais des baisses plus courtes.", group = GP)
useRSI    = input.bool(false, "Filtre RSI14 M5", tooltip = "Achat seulement si le RSI14 de la bougie de 9:30 est au-dessus de 50, vente seulement en dessous. Dans le test : +0,15R par trade au lieu de +0,11R, mais 26 % de trades en moins.", group = GP)
rsiLen    = input.int(14, "Longueur du RSI", minval = 2, group = GP)

GT = "Telegram"
tgChat    = input.string("-1003571455927", "Chat ID", tooltip = "Rempli : alertes au format de l'API Telegram. URL de webhook : https://api.telegram.org/bot<TOKEN>/sendMessage", group = GT)

GA = "Affichage"
showOrders = input.bool(true, "Ordres et trades", group = GA)
showBox    = input.bool(true, "Range de 9:30", group = GA)
keepEmpty  = input.bool(false, "Garder les ranges des jours sans trade", tooltip = "Décoché : un jour sans cassure ne laisse rien sur le graphique.", group = GA)
showTable  = input.bool(true, "Tableau", group = GA)

// ═════════════════════════ Réglages fixes ═════════════════════════
TZ_NY    = "America/New_York"
TZ_PARIS = "Europe/Paris"
FUT      = 3 * 300000      // les niveaux vivants sont projetés 3 bougies à droite

C_UP  = #26A69A
C_DN  = #EF5350
C_GR  = #787B86
C_BOX = #9598A1

if timeframe.in_seconds() != 300
    runtime.error("Ce script se trade sur un graphique M5.")

bool  isFut   = syminfo.type == "futures"
bool  isFx    = syminfo.type == "forex"
int   pxDig   = int(math.round(math.log10(1 / syminfo.mintick)))
float pipSz   = pxDig % 2 == 1 ? syminfo.mintick * 10 : syminfo.mintick
float qtyStep = isFut ? 1.0 : qtyStepIn > 0 ? qtyStepIn : isFx ? 1000.0 : syminfo.type == "crypto" ? 0.0001 : syminfo.type == "stock" ? 1.0 : 0.01
float fx      = nz(request.currency_rate(syminfo.currency, "USD", ignore_invalid_currency = true), 1.0)
float rsiV    = ta.rsi(close, rsiLen)

// ═════════════════════════ Outils ═════════════════════════
fmt(float x) =>
    str.tostring(x, format.mintick)

distTxt(float d) =>
    isFx ? str.tostring(d / pipSz, "0.0") + " pips" : fmt(d) + " pts"

rTxt(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"

tgPayload(string msg) =>
    string t = str.replace_all(str.replace_all(msg, "\\", "\\\\"), "\"", "\\\"")
    t := str.replace_all(t, "\n", "\\n")
    tgChat == "" ? msg : "{\"chat_id\": \"" + tgChat + "\", \"text\": \"" + t + "\"}"

notify(string msg) =>
    alert(tgPayload(syminfo.ticker + " · " + msg), alert.freq_once_per_bar_close)
    true

sideLabel(int x, float y, string txt, color c, string tip) =>
    label.new(x, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 15),
         textcolor = color.white, size = size.small, tooltip = tip)

// ═════════════════════════ Séance ═════════════════════════
bool isOR   = not na(time(timeframe.period, orS, TZ_NY))
bool inFlat = not na(time(timeframe.period, flatS, TZ_NY))
int  nyDate = year(time, TZ_NY) * 10000 + month(time, TZ_NY) * 100 + dayofmonth(time, TZ_NY)

// ═════════════════════════ État ═════════════════════════
type Trade
    string id
    string xid
    int    dir
    float  entry
    float  sl
    float  tp
    float  risk
    float  usd
    int    fillBar
    int    tFill
    int    day
    bool   be  = false
    line   eLn = na
    line   sLn = na
    line   tLn = na
    label  eLb = na
    label  sLb = na
    label  tLb = na

var float orH     = na
var float orL     = na
var int   orT0    = 0
var box   orBox   = na
var bool  pend    = false     // ordres stop en attente
var int   pBar    = 0
var int   pDir    = 0         // 0 = les deux côtés, 1 = achat seulement, -1 = vente seulement
var float pUSD    = na        // montant risqué du jour (taille × range), en USD
var int   tradeN  = 0
var line  lnH     = na
var line  lnL     = na
var label lbH     = na
var label lbL     = na
var Trade cur     = na
var int   seen    = 0

// Statistiques en R et texte du jour (dans un objet : les fonctions peuvent modifier ses champs)
type Stats
    int    nClosed = 0
    int    nPos    = 0
    float  sumR    = 0.0
    float  peakR   = 0.0
    float  ddR     = 0.0
    int    streak  = 0
    int    worstSt = 0
    string dayTxt  = "En attente de 9:35 NY"

var Stats S = Stats.new()

idL() => "Achat #" + str.tostring(tradeN)
idS() => "Vente #" + str.tostring(tradeN)

dropPending() =>
    if not na(lnH)
        line.delete(lnH)
    if not na(lnL)
        line.delete(lnL)
    if not na(lbH)
        label.delete(lbH)
    if not na(lbL)
        label.delete(lbL)
    true

// Ordre exécuté : le côté exécuté devient l'entrée, l'autre côté le stop
openDraw(Trade t) =>
    dropPending()
    if showOrders
        int   x2 = time + FUT
        color dc = t.dir == 1 ? C_UP : C_DN
        t.eLn := line.new(t.tFill, t.entry, x2, t.entry, xloc = xloc.bar_time, color = dc, width = 2)
        t.sLn := line.new(t.tFill, t.sl, x2, t.sl, xloc = xloc.bar_time, color = color.new(C_DN, 25), width = 1)
        if not na(t.tp)
            t.tLn := line.new(t.tFill, t.tp, x2, t.tp, xloc = xloc.bar_time, color = color.new(C_UP, 25), width = 1)
            t.tLb := sideLabel(x2, t.tp, "TP · " + fmt(t.tp), C_UP, "Objectif à " + str.tostring(tgtR) + "R")
        t.eLb := sideLabel(x2, t.entry, t.id + " · " + fmt(t.entry), dc, "Entrée")
        t.sLb := sideLabel(x2, t.sl, "SL · " + fmt(t.sl), C_DN, "Stop : de l'autre côté du range" + (beR > 0 ? ", remonté au prix d'entrée à +" + str.tostring(beR) + "R" : ""))
        label.new(t.tFill, t.entry, t.dir == 1 ? "▲" : "▼", xloc = xloc.bar_time, color = color(na),
             style = t.dir == 1 ? label.style_label_up : label.style_label_down, textcolor = dc, size = size.small,
             tooltip = t.id + " · entrée " + fmt(t.entry) + " · stop " + fmt(t.sl))
    true

moveRight(Trade t, int x2) =>
    if not na(t.eLn)
        t.eLn.set_x2(x2)
    if not na(t.sLn)
        t.sLn.set_x2(x2)
    if not na(t.tLn)
        t.tLn.set_x2(x2)
    if not na(t.eLb)
        t.eLb.set_x(x2)
    if not na(t.sLb)
        t.sLb.set_x(x2)
    if not na(t.tLb)
        t.tLb.set_x(x2)
    true

// R en direct : résultat latent du testeur (commission comprise) ÷ montant risqué
liveR(Trade t) =>
    strategy.opentrades > 0 ? strategy.opentrades.profit(0) / t.usd : (close - t.entry) * t.dir / t.risk

// Trade terminé : les lignes s'arrêtent à la sortie et s'estompent, le résultat reste affiché
closeDraw(Trade t, int xe, float px, float r, string why) =>
    moveRight(t, xe)
    for lb in array.from(t.eLb, t.sLb, t.tLb)
        if not na(lb)
            label.delete(lb)
    if not na(t.eLn)
        t.eLn.set_width(1)
    if not na(t.sLn)
        t.sLn.set_color(color.new(C_DN, 60))
    if not na(t.tLn)
        t.tLn.set_color(color.new(C_UP, 60))
    if showOrders
        label.new(xe, px, rTxt(r), xloc = xloc.bar_time, style = label.style_label_left,
             color = color.new(r >= 0 ? C_UP : C_DN, 20), textcolor = color.white, size = size.small,
             tooltip = t.id + " · " + why + " · entrée " + fmt(t.entry) + " · sortie " + fmt(px))
    true

newTrade(int d, float entry, int tFill, int fBar) =>
    float sl = d == 1 ? orL : orH
    float rk = math.abs(entry - sl)
    float tp = tgtR > 0 ? entry + d * tgtR * rk : na
    Trade.new(d == 1 ? idL() : idS(), d == 1 ? "X" + idL() : "X" + idS(), d, entry, sl, tp, rk, pUSD, fBar, tFill, nyDate)

recordClose(Trade t, int k) =>
    float px = strategy.closedtrades.exit_price(k)
    float r  = strategy.closedtrades.profit(k) / t.usd
    S.nClosed += 1
    S.sumR    += r
    if r > 0.05
        S.nPos += 1
    // série de pertes : comme dans le test, un trade à ~0R (stop à l'entrée) interrompt la série
    S.streak := r < -0.05 ? S.streak + 1 : 0
    S.worstSt := math.max(S.worstSt, S.streak)
    S.peakR   := math.max(S.peakR, S.sumR)
    S.ddR     := math.max(S.ddR, S.peakR - S.sumR)
    string why = strategy.closedtrades.exit_comment(k)
    closeDraw(t, strategy.closedtrades.exit_time(k), px, r, why)
    notify(t.id + " clôturé (" + why + ") : " + rTxt(r) + " à " + fmt(px))
    S.dayTxt := t.id + " terminé : " + rTxt(r)
    true

// ═════════════════════════ Exécutions et sorties ═════════════════════════
if pend and na(cur) and (strategy.position_size != 0 or strategy.closedtrades > seen)
    // Un des deux ordres stop vient d'être exécuté (éventuellement stoppé sur la même bougie)
    pend := false
    if strategy.position_size != 0
        int d = strategy.position_size > 0 ? 1 : -1
        cur := newTrade(d, strategy.opentrades.entry_price(0), strategy.opentrades.entry_time(0), strategy.opentrades.entry_bar_index(0))
        // Objectif posé maintenant, depuis le prix d'exécution réel (comme dans le test : pas d'objectif sur la bougie d'entrée)
        if not na(cur.tp)
            strategy.exit(cur.xid, from_entry = cur.id, stop = cur.sl, limit = cur.tp, comment_loss = "Stop", comment_profit = "Objectif")
        openDraw(cur)
        notify((d == 1 ? "ACHAT" : "VENTE") + " exécuté : " + cur.id + " à " + fmt(cur.entry) + "\nStop : " + fmt(cur.sl) +
             (beR > 0 ? "\nStop au prix d'entrée dès " + fmt(cur.entry + d * beR * cur.risk) + " (+" + str.tostring(beR) + "R)" : "") +
             (not na(cur.tp) ? "\nObjectif : " + fmt(cur.tp) : "\nSortie à 15:45 NY si ni stop ni objectif"))
        S.dayTxt := cur.id + " en cours"
    else
        int k = strategy.closedtrades - 1
        int d = strategy.closedtrades.size(k) > 0 ? 1 : -1
        Trade t = newTrade(d, strategy.closedtrades.entry_price(k), strategy.closedtrades.entry_time(k), strategy.closedtrades.entry_bar_index(k))
        openDraw(t)
        recordClose(t, k)
else if not na(cur) and strategy.closedtrades > seen
    recordClose(cur, strategy.closedtrades - 1)
    cur := na
else if not na(cur)
    // Trade ouvert : stop au prix d'entrée une fois le seuil atteint (à partir de la bougie suivant l'entrée)
    if beR > 0 and not cur.be and bar_index > cur.fillBar and (cur.dir == 1 ? high >= cur.entry + beR * cur.risk : low <= cur.entry - beR * cur.risk)
        cur.be := true
        strategy.exit(cur.xid, from_entry = cur.id, stop = cur.entry, limit = cur.tp, comment_loss = "Stop à l'entrée", comment_profit = "Objectif")
        if not na(cur.sLn)
            cur.sLn.set_y1(cur.entry)
            cur.sLn.set_y2(cur.entry)
            cur.sLn.set_color(color.new(C_GR, 20))
        if not na(cur.sLb)
            cur.sLb.set_y(cur.entry)
            cur.sLb.set_text("SL · entrée")
            cur.sLb.set_color(color.new(C_GR, 15))
        notify(cur.id + " : +" + str.tostring(beR) + "R atteint, stop déplacé au prix d'entrée (" + fmt(cur.entry) + ")")
    moveRight(cur, time + FUT)
    if not na(cur.eLb)
        float r = liveR(cur)
        cur.eLb.set_text(cur.id + " · " + fmt(cur.entry) + " · " + rTxt(r))
        cur.eLb.set_color(color.new(r >= 0 ? C_UP : C_DN, 15))
seen := strategy.closedtrades

// Fin de journée (et sécurité : une position ne passe jamais la nuit, même un jour de fermeture anticipée)
if strategy.position_size != 0 and (inFlat or (not na(cur) and nyDate != cur.day))
    strategy.close_all(comment = "Fin de journée")

// ═════════════════════════ Ordres en attente : annulation ═════════════════════════
if pend and strategy.position_size == 0 and bar_index > pBar
    bool late     = bar_index - pBar >= liveBars
    bool oppFirst = pDir == 1 ? low <= orL : pDir == -1 ? high >= orH : false
    if late or oppFirst
        strategy.cancel(idL())
        strategy.cancel(idS())
        pend := false
        dropPending()
        if not keepEmpty and not na(orBox)
            box.delete(orBox)
        else if not na(orBox)
            orBox.set_bgcolor(color.new(C_BOX, 94))
        string why = oppFirst ? "l'autre côté du range a été touché d'abord (filtre RSI)" : "pas de cassure avant " + str.format_time(time_close, "HH:mm", TZ_NY) + " NY"
        S.dayTxt := "Pas de trade : " + why
        notify("ordres annulés : " + why)
    else
        int x2 = time + FUT
        if not na(lnH)
            lnH.set_x2(x2)
            lbH.set_x(x2)
        if not na(lnL)
            lnL.set_x2(x2)
            lbL.set_x(x2)

// ═════════════════════════ 9:35 NY : range et ordres ═════════════════════════
if isOR and strategy.position_size == 0 and not pend and na(cur)
    orH  := high
    orL  := low
    orT0 := time
    float dist = orH - orL
    pDir := useRSI ? (rsiV > 50 ? 1 : rsiV < 50 ? -1 : 2) : 0
    float qty = dist > 0 ? math.floor((strategy.initial_capital + strategy.netprofit) * riskPct / 100 / (dist * syminfo.pointvalue * fx) / qtyStep) * qtyStep : na
    if showBox
        orBox := box.new(time, orH, time + (liveBars + 1) * 300000, orL, xloc = xloc.bar_time,
             bgcolor = color.new(C_BOX, 88), border_color = color.new(C_BOX, 60), border_width = 1,
             text = "9:30", text_size = size.tiny, text_color = color.new(C_BOX, 30), text_halign = text.align_left, text_valign = text.align_top)
    if na(qty) or qty <= 0 or pDir == 2
        S.dayTxt := pDir == 2 ? "Pas de trade : RSI exactement à 50" : "Pas de trade : taille nulle (réduire le pas de taille ou augmenter le risque)"
    else
        tradeN += 1
        pend   := true
        pBar   := bar_index
        pUSD   := qty * dist * syminfo.pointvalue * fx
        // L'objectif éventuel est ajouté à l'exécution, depuis le prix réel d'entrée
        if pDir != -1
            strategy.entry(idL(), strategy.long, qty = qty, stop = orH, oca_name = "ORB" + str.tostring(tradeN), oca_type = strategy.oca.cancel, comment = "Cassure du high")
            strategy.exit("X" + idL(), from_entry = idL(), stop = orL, comment_loss = "Stop")
        if pDir != 1
            strategy.entry(idS(), strategy.short, qty = qty, stop = orL, oca_name = "ORB" + str.tostring(tradeN), oca_type = strategy.oca.cancel, comment = "Cassure du low")
            strategy.exit("X" + idS(), from_entry = idS(), stop = orH, comment_loss = "Stop")
        if showOrders
            int x2 = time + FUT
            if pDir != -1
                lnH := line.new(time, orH, x2, orH, xloc = xloc.bar_time, color = color.new(C_UP, 10), style = line.style_dashed, width = 1)
                lbH := sideLabel(x2, orH, "Achat stop · " + fmt(orH), C_UP, "Stop : " + fmt(orL))
            if pDir != 1
                lnL := line.new(time, orL, x2, orL, xloc = xloc.bar_time, color = color.new(C_DN, 10), style = line.style_dashed, width = 1)
                lbL := sideLabel(x2, orL, "Vente stop · " + fmt(orL), C_DN, "Stop : " + fmt(orH))
        S.dayTxt := (pDir == 1 ? "Achat stop " + fmt(orH) : pDir == -1 ? "Vente stop " + fmt(orL) : "Achat " + fmt(orH) + " · Vente " + fmt(orL)) + " · jusqu'à 9:45"
        notify("ORDRES ORB placés · " + str.format_time(time_close, "HH:mm", TZ_NY) + " NY (" + str.format_time(time_close, "HH:mm", TZ_PARIS) + " Paris)" +
             "\nRange 9:30 : " + fmt(orL) + " – " + fmt(orH) + " (" + distTxt(dist) + " = 1R)" +
             (pDir != -1 ? "\nAchat stop : " + fmt(orH) + " · stop " + fmt(orL) : "") +
             (pDir != 1 ? "\nVente stop : " + fmt(orL) + " · stop " + fmt(orH) : "") +
             (tgtR > 0 ? "\nObjectif : +" + str.tostring(tgtR) + "R depuis le prix d'exécution" : "") +
             "\nTaille : " + str.tostring(qty) + (isFut ? " contrat(s)" : "") + " · " + str.tostring(pUSD, "0.##") + " $ risqués (" + str.tostring(riskPct) + " %)" +
             "\nValables " + str.tostring(liveBars * 5) + " min. Le premier exécuté annule l'autre." +
             (beR > 0 ? "\nStop au prix d'entrée à +" + str.tostring(beR) + "R" : "") + (tgtR > 0 ? "" : " · sortie à 15:45 NY"))

// ═════════════════════════ Tableau ═════════════════════════
cellRow(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(chart.fg_color, 40), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

var table tb = table.new(position.top_right, 2, 4, bgcolor = color.new(color.gray, 90), border_width = 0, frame_width = 0)
if showTable and barstate.islast
    color fg = chart.fg_color
    cellRow(tb, 0, "Range 9:30", na(orH) ? "—" : fmt(orL) + " – " + fmt(orH) + " (" + distTxt(orH - orL) + ")", fg)
    float lr = not na(cur) ? liveR(cur) : na
    cellRow(tb, 1, "Aujourd'hui", not na(cur) ? cur.id + " · " + rTxt(lr) + (cur.be ? " · stop à l'entrée" : "") : S.dayTxt,
         not na(cur) ? (lr >= 0 ? C_UP : C_DN) : fg)
    cellRow(tb, 2, "Historique", S.nClosed == 0 ? "aucun trade" : str.tostring(S.nClosed) + " trades · " + str.tostring(100.0 * S.nPos / S.nClosed, "0") + " % gagnants · " + rTxt(S.sumR),
         S.nClosed == 0 ? fg : S.sumR >= 0 ? C_UP : C_DN)
    cellRow(tb, 3, "Par trade · pire baisse", S.nClosed == 0 ? "—" : (S.sumR >= 0 ? "+" : "") + str.tostring(S.sumR / S.nClosed, "0.00") + "R · -" + str.tostring(S.ddR, "0.0") + "R · " + str.tostring(S.worstSt) + " pertes de suite", fg)
