//@version=6
// AMD+ v2 — Liquidité multi-sessions, biais journalier figé, confirmation par changement de structure M5
// Graphique M5, tout marché (indices, forex, or, crypto). Toutes les heures sont en heure de New York.
//
// Ce qui change par rapport à la v1 (réglages par défaut choisis d'après un test sur 60 jours M5,
// du 31/08 au 09/11/2026, sur NQ, ES, YM, RTY, or et euro) :
//  • Confirmation : après le sweep, une bougie M5 doit clôturer au-delà du niveau pris ET du dernier swing M5
//    (changement de structure, CHoCH) dans les 10 bougies. C'est le changement qui compte le plus.
//  • Liquidité : en plus du range asiatique, le high / low de la veille (PDH / PDL), le high / low de Londres
//    pour New York matin, et le high / low de New York matin pour l'après-midi.
//  • Sessions : Londres, New York matin et New York après-midi.
//  • Premium / discount : on vend dans la moitié haute du range du jour, on achète dans la moitié basse.
//  • Objectif : la poche de liquidité intacte la plus proche de l'autre côté (entre 1,5R et 4R), sinon 2R.
//  • Entrée : ordre limite au milieu de la bougie de cassure.
//  • Biais : désactivé par défaut. Aucun des biais testés (journalier, H4, H1, dans le sens ou contre) n'a
//    amélioré le résultat sur la période. Ils restent disponibles pour tes propres tests, figés pour la journée.
//  • Statistiques par séance et par poche : pour garder ce qui gagne et couper ce qui perd.
//
// Gestion : un trade à la fois, chaque poche une seule fois par jour, 3 trades et 2 pertes max par jour.
// Tout est fermé à 15:50 NY.
strategy("AMD+ v2 : liquidité, CHoCH et biais journalier", shorttitle = "AMD+ v2", overlay = true,
     initial_capital = 10000, currency = currency.USD, pyramiding = 1,
     process_orders_on_close = true, margin_long = 0, margin_short = 0, slippage = 2,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ═════════════════════════ Textes des menus ═════════════════════════
C_CHOCH   = "Changement de structure M5 (CHoCH)"
C_RECL    = "Reclôture au-delà du niveau (v1)"
E_FVG     = "Milieu du FVG de la cassure"
E_MID     = "Milieu de la bougie de cassure"
E_CLOSE   = "Clôture de la bougie de cassure (au marché)"
T_R       = "R fixe"
T_LIQ     = "Poche de liquidité opposée"
B_D1      = "Journalier : bougie de la veille"
B_H4      = "Structure H4 (figée à 19:00 NY)"
B_BOTH    = "Journalier et H4 d'accord"
B_H1      = "Structure H1 (v1, change en séance)"
B_NONE    = "Aucun"
U_WITH    = "Dans le sens du biais"
U_AGAINST = "Contre le biais"
N_BOTH    = "Trader les deux côtés"
N_SKIP    = "Ne pas trader"

// ═════════════════════════ Paramètres ═════════════════════════
GR = "Risque"
riskPct   = input.float(1.0, "Risque par trade (% du capital)", minval = 0.1, step = 0.1, tooltip = "1 % tant que la v2 n'est pas validée sur ton historique. Une série de 9 pertes coûte environ 9 % du capital à 1 %, 18 % à 2 %.", group = GR)
maxTrades = input.int(3, "Trades max par jour", minval = 1, maxval = 6, group = GR)
maxLoss   = input.int(2, "Pertes max par jour", minval = 1, maxval = 6, tooltip = "Après ce nombre de stops dans la journée, plus aucun trade jusqu'au lendemain. C'est la protection principale contre les séries de SL.", group = GR)
qtyStepIn = input.float(0, "Pas de taille (0 = auto)", minval = 0, step = 0.01, tooltip = "Taille minimale chez le broker, en unités TradingView. Auto : futures = 1 contrat, forex = 1000 unités (0,01 lot), crypto = 0,0001, actions = 1, CFD = 0,01.", group = GR)

GS = "Sessions (heure de New York)"
asiaS = input.session("1900-0200", "Asie : accumulation", tooltip = "01:00-08:00 à Paris la plupart de l'année. Le début de l'Asie marque aussi le début de la journée de trading.", group = GS)
lonS  = input.session("0200-0500", "Kill zone Londres", tooltip = "08:00-11:00 à Paris la plupart de l'année.", group = GS)
useNY = input.bool(true, "Kill zone New York matin", inline = "ny", group = GS)
nyS   = input.session("0830-1100", "", inline = "ny", tooltip = "14:30-17:00 à Paris la plupart de l'année.", group = GS)
usePM = input.bool(true, "Kill zone New York après-midi", inline = "pm", group = GS)
pmS   = input.session("1330-1500", "", inline = "pm", tooltip = "19:30-21:00 à Paris. Séance souvent plus calme : à tester avant de l'activer.", group = GS)
flatS = input.session("1550-1800", "Fermeture de fin de journée", tooltip = "Toutes les positions sont fermées dans cette fenêtre.", group = GS)

GL = "Poches de liquidité"
poolAsia = input.bool(true, "High / low de l'Asie", group = GL)
poolPD   = input.bool(true, "High / low de la veille (PDH / PDL)", tooltip = "Journée de trading = 19:00 → 19:00 NY.", group = GL)
poolLon  = input.bool(true, "High / low de Londres (pour New York)", group = GL)
poolNY   = input.bool(true, "High / low de New York matin (pour l'après-midi)", tooltip = "Utile seulement si la kill zone de l'après-midi est activée.", group = GL)
consumeOut = input.bool(false, "Poche prise hors kill zone = consommée", tooltip = "Coché : une poche dépassée hors kill zone est retirée sans trade. Décoché (meilleur sur le test) : elle reste, et si le prix est déjà au-delà à l'ouverture de la kill zone, le sweep compte dès la première bougie.", group = GL)

GP = "Confirmation et entrée"
confMode  = input.string(C_CHOCH, "Confirmation du sweep", options = [C_CHOCH, C_RECL], tooltip = "CHoCH : une bougie M5 clôture au-delà du niveau pris ET au-delà du dernier swing M5 (la structure change de sens). Reclôture : la règle de la v1, simple retour dans le niveau.", group = GP)
confMax   = input.int(10, "Confirmation sous (bougies)", minval = 0, maxval = 30, tooltip = "Nombre de bougies après le sweep pour obtenir la confirmation. Sinon c'est une vraie cassure : le setup est abandonné.", group = GP)
swLen     = input.int(2, "Swings M5 : bougies de chaque côté", minval = 1, maxval = 5, tooltip = "Un swing high est une bougie plus haute que les N bougies de chaque côté. 2 = petits swings, réactifs. 3 ou 4 = swings plus solides, moins de signaux.", group = GP)
dispMin   = input.float(0.0,"Déplacement minimum (corps en ATR M5)", minval = 0, step = 0.1, tooltip = "Corps de la bougie qui confirme, en ATR M5, dans le sens du trade. 0 = pas de condition.", group = GP)
entryMode = input.string(E_MID, "Entrée", options = [E_FVG, E_MID, E_CLOSE], group = GP)
limitBars = input.int(20, "Durée de l'ordre limite (bougies M5)", minval = 1, maxval = 60, group = GP)
pdFilter  = input.bool(true, "Premium / discount", tooltip = "Vente seulement si l'entrée est au-dessus du milieu du range du jour, achat seulement en dessous.", group = GP)

GX = "Stop et objectif"
slBuf    = input.float(0.1, "Marge du stop au-delà de la mèche (ATR M5)", minval = 0.0, step = 0.05, group = GX)
minStop  = input.float(1.0, "Stop minimum (ATR M5)", minval = 0.1, step = 0.1, group = GX)
padNas   = input.float(0.0, "Nasdaq : écart ajouté au SL (points)", minval = 0, step = 1, tooltip = "NQ, MNQ, NAS100, US100, USTEC, NDX. 0 = pas de marge.", group = GX)
padFx    = input.float(40.0, "Forex : écart ajouté au SL (pips)", minval = 0, step = 1, group = GX)
padOther = input.float(0.0, "Autres marchés : écart ajouté au SL (prix)", minval = 0, group = GX)
tgtMode  = input.string(T_LIQ, "Objectif", options = [T_R, T_LIQ], tooltip = "Poche opposée : l'objectif est la poche de liquidité intacte la plus proche de l'autre côté (ex. Asie L pour une vente), si elle est au moins au R minimum. Sinon l'objectif en R fixe s'applique.", group = GX)
rrT      = input.float(2.0, "Objectif en R fixe", minval = 0.5, step = 0.25, group = GX)
rrMin    = input.float(1.5, "Poche opposée : R minimum", minval = 0.5, step = 0.25, group = GX)
rrMax    = input.float(4.0, "Poche opposée : R maximum", minval = 1.0, step = 0.5, group = GX)
beR      = input.float(0.0, "Stop au prix d'entrée à partir de (R)", minval = 0, step = 0.25, tooltip = "0 = désactivé. Ex. 1 : dès que le trade atteint +1R, le stop passe au prix d'entrée.", group = GX)

GB = "Biais"
biasSrc     = input.string(B_NONE, "Source du biais", options = [B_NONE, B_D1, B_H4, B_BOTH, B_H1], tooltip = "Désactivé par défaut : sur le test du 31/08 au 09/11/2026, aucun biais n'a amélioré le résultat, il retirait surtout des trades gagnants. Journalier : la veille a clôturé au-dessus du high précédent → haussier ; en dessous du low précédent → baissier ; a pris le high précédent puis reclôturé dessous → baissier ; a pris le low précédent puis reclôturé dessus → haussier ; resté dans le range → neutre. Calculé à 19:00 NY, fixe toute la journée.", group = GB)
biasUse     = input.string(U_WITH, "Utilisation", options = [U_WITH, U_AGAINST], group = GB)
neutralMode = input.string(N_BOTH, "Si le biais est neutre", options = [N_BOTH, N_SKIP], group = GB)

GF = "SMT"
useSMT   = input.bool(false, "Divergence SMT avec l'actif corrélé", tooltip = "Le setup n'est pris que si l'actif corrélé n'a PAS pris le même niveau (son propre high de l'Asie, de la veille ou de Londres).", group = GF)
smtSymIn = input.string("", "Actif corrélé (vide = auto)", tooltip = "Vide : NQ ↔ ES, YM / RTY → ES, EURUSD ↔ GBPUSD, AUDUSD ↔ NZDUSD, or ↔ argent, BTC ↔ ETH. Sinon un symbole complet, ex. PEPPERSTONE:US500.", group = GF)
smtInv   = input.bool(false, "Corrélation inverse", tooltip = "À cocher si l'actif corrélé évolue à l'inverse (ex. EURUSD contre DXY).", group = GF)

GT = "Telegram"
tgChat = input.string("-1003571455927", "Chat ID", tooltip = "Rempli : alertes au format de l'API Telegram. URL de webhook : https://api.telegram.org/bot<TOKEN>/sendMessage", group = GT)

GA = "Affichage"
showLv     = input.bool(true, "Poches de liquidité", group = GA)
showTrades = input.bool(true, "Ordres et trades", group = GA)
showBox    = input.bool(true, "Boîte du range asiatique", group = GA)
showSetup  = input.bool(true, "Sweeps confirmés", group = GA)
showKZ     = input.bool(true, "Fond des kill zones", group = GA)
showRej    = input.bool(true, "Setups écartés (raison au survol)", group = GA)
showTable  = input.bool(true, "Tableau de bord", group = GA)
showDiag   = input.bool(true, "Diagnostic (entonnoir des setups)", group = GA)
showStats  = input.bool(true, "Statistiques en R", group = GA)

// ═════════════════════════ Réglages fixes ═════════════════════════
TZ_NY    = "America/New_York"
TZ_PARIS = "Europe/Paris"
FUT      = 10 * 300000   // les niveaux d'un trade vivant sont projetés 10 bougies à droite

C_LON  = #4FC3F7
C_NY   = #FFB74D
C_PD   = #FFD54F
C_ASIA = #BA68C8
C_UP   = #26A69A
C_DN   = #EF5350
C_SL   = #787B86

if timeframe.in_seconds() != 300
    runtime.error("Ce script se trade sur un graphique M5.")

string tk     = str.upper(syminfo.ticker)
bool   isFut  = syminfo.type == "futures"
bool   isFx   = syminfo.type == "forex"
bool   isNasS = str.contains(tk, "NQ") or str.contains(tk, "NAS") or str.contains(tk, "NDX") or str.contains(tk, "US100") or str.contains(tk, "USTEC") or str.contains(tk, "TECH100")
int    pxDig  = int(math.round(math.log10(1 / syminfo.mintick)))
float  pipSz  = pxDig % 2 == 1 ? syminfo.mintick * 10 : syminfo.mintick
float  padPx  = isFx ? padFx * pipSz : isNasS ? padNas : padOther
float  qtyStep = isFut ? 1.0 : qtyStepIn > 0 ? qtyStepIn : isFx ? 1000.0 : syminfo.type == "crypto" ? 0.0001 : syminfo.type == "stock" ? 1.0 : 0.01

autoPeer() =>
    string s = ""
    if isNasS
        s := "CME_MINI:ES1!"
    else if (isFut and (str.startswith(tk, "ES") or str.startswith(tk, "MES"))) or str.contains(tk, "SPX") or str.contains(tk, "US500") or str.contains(tk, "SP500")
        s := "CME_MINI:NQ1!"
    else if (isFut and (str.startswith(tk, "YM") or str.startswith(tk, "MYM") or str.startswith(tk, "RTY") or str.startswith(tk, "M2K"))) or str.contains(tk, "US30") or str.contains(tk, "WS30") or str.contains(tk, "DJI") or str.contains(tk, "US2000")
        s := "CME_MINI:ES1!"
    else if str.startswith(tk, "EURUSD")
        s := "FX:GBPUSD"
    else if str.startswith(tk, "GBPUSD")
        s := "FX:EURUSD"
    else if str.startswith(tk, "AUDUSD")
        s := "FX:NZDUSD"
    else if str.startswith(tk, "NZDUSD")
        s := "FX:AUDUSD"
    else if str.contains(tk, "XAU") or str.contains(tk, "GOLD") or (isFut and (str.startswith(tk, "GC") or str.startswith(tk, "MGC")))
        s := isFut ? "COMEX:SI1!" : "OANDA:XAGUSD"
    else if str.contains(tk, "XAG") or str.contains(tk, "SILVER") or (isFut and str.startswith(tk, "SI"))
        s := isFut ? "COMEX:GC1!" : "OANDA:XAUUSD"
    else if str.contains(tk, "BTC")
        s := "BINANCE:ETHUSDT"
    else if str.contains(tk, "ETH")
        s := "BINANCE:BTCUSDT"
    s

string peerSym  = smtSymIn != "" ? smtSymIn : autoPeer()
bool   smtAvail = peerSym != ""

// ═════════════════════════ Données ═════════════════════════
// Structure d'une unité de temps supérieure : dernière cassure en clôture d'un swing, lue sur la bougie déjà clôturée
htfTrend(int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float sh     = na
    var float sl     = na
    var bool  shDone = false
    var bool  slDone = false
    var int   trend  = 0
    if not na(ph)
        sh     := ph
        shDone := false
    if not na(pl)
        sl     := pl
        slDone := false
    if not na(sh) and not shDone and close > sh
        shDone := true
        trend  := 1
    if not na(sl) and not slDone and close < sl
        slDone := true
        trend  := -1
    trend[1]

int h1Now = nz(request.security(syminfo.tickerid, "60", htfTrend(2), lookahead = barmerge.lookahead_on))
int h4Now = nz(request.security(syminfo.tickerid, "240", htfTrend(2), lookahead = barmerge.lookahead_on))
[pH0, pL0] = request.security(smtAvail ? peerSym : syminfo.tickerid, timeframe.period, [high, low])
// Corrélation inverse : les prix de l'actif corrélé sont inversés, son high joue le rôle de son low
float pH   = smtInv ? -pL0 : pH0
float pL   = smtInv ? -pH0 : pL0
float fx   = nz(request.currency_rate(syminfo.currency, "USD", ignore_invalid_currency = true), 1.0)
float atr5 = ta.atr(14)

// Swings M5, confirmés swLen bougies plus tard (aucun regard vers le futur)
float pvH = ta.pivothigh(high, swLen, swLen)
float pvL = ta.pivotlow(low, swLen, swLen)
var float lastSwH = na
var float lastSwL = na
if not na(pvH)
    lastSwH := pvH
if not na(pvL)
    lastSwL := pvL

// FVG formé sur les dernières bougies : milieu (CE) du plus récent
fvgCE(int d) =>
    float ce = na
    for k = 0 to 2
        if na(ce)
            if d == -1 and high[k] < low[k + 2]
                ce := (high[k] + low[k + 2]) / 2
            else if d == 1 and low[k] > high[k + 2]
                ce := (low[k] + high[k + 2]) / 2
    ce

float fvgDn = fvgCE(-1)
float fvgUp = fvgCE(1)

// ═════════════════════════ Outils ═════════════════════════
fmt(float x) =>
    str.tostring(x, format.mintick)

distTxt(float d) =>
    isFx ? str.tostring(d / pipSz, "0.0") + " pips" : fmt(d) + " pts"

rTxt(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"

biasTxt(int b) =>
    b == 1 ? "Haussier ▲" : b == -1 ? "Baissier ▼" : "Neutre"

kindColor(int k) =>
    k == 0 ? C_ASIA : k == 1 ? C_PD : k == 2 ? C_LON : C_NY

kindName(int k) =>
    k == 0 ? "Poche Asie" : k == 1 ? "Poche veille (PDH / PDL)" : k == 2 ? "Poche Londres" : "Poche NY matin"

sessName(int s) =>
    s == 0 ? "Londres" : s == 1 ? "New York matin" : "New York après-midi"

nrTxt(int n, float r) =>
    n == 0 ? "—" : str.tostring(n) + " trades · " + rTxt(r) + " · " + (r / n >= 0 ? "+" : "") + str.tostring(r / n, "0.00") + "R / trade"

tgPayload(string msg) =>
    string t = str.replace_all(str.replace_all(msg, "\\", "\\\\"), "\"", "\\\"")
    t := str.replace_all(t, "\n", "\\n")
    tgChat == "" ? msg : "{\"chat_id\": \"" + tgChat + "\", \"text\": \"" + t + "\"}"

markReject(int dir, string why) =>
    if showRej
        label.new(time, dir == 1 ? low : high, dir == 1 ? "△" : "▽", xloc = xloc.bar_time, color = color(na),
             style = dir == 1 ? label.style_label_up : label.style_label_down,
             textcolor = color.new(dir == 1 ? C_UP : C_DN, 45), size = size.small,
             tooltip = (dir == 1 ? "Achat écarté" : "Vente écartée") + " · " + str.format_time(time, "dd/MM HH:mm", TZ_PARIS) + " (Paris)\n" + why)
    true

// ═════════════════════════ Ranges et poches de liquidité ═════════════════════════
type Rng
    float hi  = na
    float lo  = na
    float phi = na    // même range sur l'actif corrélé
    float plo = na
    int   t0  = 0

method begin(Rng r) =>
    r.hi  := high
    r.lo  := low
    r.phi := pH
    r.plo := pL
    r.t0  := time
    r

method grow(Rng r) =>
    if na(r.hi)
        r.hi := high
        r.lo := low
        r.t0 := time
    else
        r.hi := math.max(r.hi, high)
        r.lo := math.min(r.lo, low)
    if not na(pH)
        r.phi := na(r.phi) ? pH : math.max(r.phi, pH)
    if not na(pL)
        r.plo := na(r.plo) ? pL : math.min(r.plo, pL)
    r

type Pool
    string name
    int    kind            // 0 Asie, 1 veille, 2 Londres, 3 NY matin
    int    dir             // -1 = high (setup de vente), 1 = low (setup d'achat)
    float  lvl
    float  plvl            // même niveau sur l'actif corrélé
    bool   used   = false
    bool   ptaken = false  // l'actif corrélé a pris son propre niveau
    line   ln     = na
    label  lb     = na

addPool(array<Pool> arr, string name, int kind, int dir, float lvl, float plvl, int t0) =>
    if not na(lvl)
        Pool p = Pool.new(name, kind, dir, lvl, plvl)
        if showLv
            color c = kindColor(kind)
            p.ln := line.new(t0, lvl, time, lvl, xloc = xloc.bar_time, color = c, style = line.style_dotted, width = 1)
            p.lb := label.new(t0, lvl, name + " · " + fmt(lvl), xloc = xloc.bar_time, color = color(na),
                 style = dir == -1 ? label.style_label_lower_left : label.style_label_upper_left, textcolor = c, size = size.small)
        arr.push(p)
    true

// ═════════════════════════ Sessions ═════════════════════════
bool inAsia = not na(time(timeframe.period, asiaS, TZ_NY))
bool lonRaw = not na(time(timeframe.period, lonS, TZ_NY))
bool nyRaw  = not na(time(timeframe.period, nyS, TZ_NY))
bool inLon  = lonRaw
bool inNY   = useNY and nyRaw
bool inPM   = usePM and not na(time(timeframe.period, pmS, TZ_NY))
bool inKZ   = inLon or inNY or inPM
bool inFlat = not na(time(timeframe.period, flatS, TZ_NY))
int  sessNow = inLon ? 0 : inNY ? 1 : 2

bgcolor(showKZ and inLon ? color.new(C_LON, 94) : showKZ and (inNY or inPM) ? color.new(C_NY, 94) : na, title = "Kill zones")

// ═════════════════════════ État ═════════════════════════
var Rng day  = Rng.new()
var Rng asia = Rng.new()
var Rng lon  = Rng.new()
var Rng nyam = Rng.new()
var float  yH    = na     // veille
var float  yL    = na
var float  yC    = na
var float  yPH   = na
var float  yPL   = na
var float  ppH   = na     // avant-veille
var float  ppL   = na
var int    dBias = 0
var string dWhy  = "pas encore d'historique"
var int    h4Day = 0
var array<Pool> pools = array.new<Pool>()
var int    nToday    = 0
var int    lossToday = 0
var int    nDays     = 0

// Sweep en attente de confirmation, un par côté : 0 = high pris (vente), 1 = low pris (achat)
var array<bool>   stOn    = array.new<bool>(2, false)
var array<float>  stExt   = array.new<float>(2, na)
var array<float>  stLvl   = array.new<float>(2, na)
var array<float>  stChoch = array.new<float>(2, na)
var array<int>    stBar   = array.new<int>(2, 0)
var array<int>    stPool  = array.new<int>(2, -1)
var array<string> stName  = array.new<string>(2, "")

// Diagnostic
var int cSweep  = 0
var int cOut    = 0
var int cNoConf = 0
var int cKzEnd  = 0
var int cSig    = 0
var int cSmt    = 0
var int cBias   = 0
var int cPD     = 0
var int cBusy   = 0
var int cOrder  = 0
var int cMiss   = 0
var int cExp    = 0
var int nFilled = 0

// Statistiques en R
var float sumR    = 0.0
var float winR    = 0.0
var float lossR   = 0.0
var float peakR   = 0.0
var float ddR     = 0.0
var int   nClosed = 0
var int   nPos    = 0
var int   streak  = 0
var int   worstSt = 0
var int   firstTr = 0
var int   lastTr  = 0
var array<int>   sN = array.new<int>(3, 0)
var array<float> sR = array.new<float>(3, 0.0)
var array<int>   kN = array.new<int>(4, 0)
var array<float> kR = array.new<float>(4, 0.0)

// Nouvelle journée au début de l'Asie : biais du jour figé, poches remises à zéro
bool newDay = inAsia and not inAsia[1]
if newDay
    ppH := yH
    ppL := yL
    yH  := day.hi
    yL  := day.lo
    yPH := day.phi
    yPL := day.plo
    yC  := close[1]
    if na(ppH) or na(yH)
        dBias := 0
        dWhy  := "pas encore d'historique"
    else if yC > ppH
        dBias := 1
        dWhy  := "la veille a clôturé au-dessus du high précédent"
    else if yC < ppL
        dBias := -1
        dWhy  := "la veille a clôturé sous le low précédent"
    else if yH > ppH and yC < ppH
        dBias := -1
        dWhy  := "la veille a pris le high précédent puis reclôturé dessous"
    else if yL < ppL and yC > ppL
        dBias := 1
        dWhy  := "la veille a pris le low précédent puis reclôturé dessus"
    else
        dBias := 0
        dWhy  := "la veille est restée dans le range précédent"
    h4Day := h4Now
    day.begin()
    asia.begin()
    lon  := Rng.new()
    nyam := Rng.new()
    pools.clear()
    stOn.set(0, false)
    stOn.set(1, false)
    nToday    := 0
    lossToday := 0
    nDays     += 1
    if poolPD
        addPool(pools, "PDH", 1, -1, yH, yPH, time)
        addPool(pools, "PDL", 1, 1, yL, yPL, time)
else
    day.grow()
    if inAsia
        asia.grow()

int biasNow = biasSrc == B_D1 ? dBias : biasSrc == B_H4 ? h4Day : biasSrc == B_BOTH ? (dBias == h4Day ? dBias : 0) : biasSrc == B_H1 ? h1Now : 0

// Fin de l'Asie : high / low de l'Asie
if not inAsia and inAsia[1] and not na(asia.hi)
    if showBox
        box.new(asia.t0, asia.hi, time, asia.lo, xloc = xloc.bar_time, bgcolor = color.new(C_ASIA, 92), border_width = 0)
    if poolAsia
        addPool(pools, "Asie H", 0, -1, asia.hi, asia.phi, asia.t0)
        addPool(pools, "Asie L", 0, 1, asia.lo, asia.plo, asia.t0)

// Londres : son high / low deviennent des poches pour New York
if lonRaw and not lonRaw[1]
    lon.begin()
else if lonRaw
    lon.grow()
if not lonRaw and lonRaw[1] and poolLon and (useNY or usePM) and not na(lon.hi)
    addPool(pools, "Londres H", 2, -1, lon.hi, lon.phi, lon.t0)
    addPool(pools, "Londres L", 2, 1, lon.lo, lon.plo, lon.t0)

// New York matin : son high / low deviennent des poches pour l'après-midi
if nyRaw and not nyRaw[1]
    nyam.begin()
else if nyRaw
    nyam.grow()
if not nyRaw and nyRaw[1] and poolNY and usePM and not na(nyam.hi)
    addPool(pools, "NY matin H", 3, -1, nyam.hi, nyam.phi, nyam.t0)
    addPool(pools, "NY matin L", 3, 1, nyam.lo, nyam.plo, nyam.t0)

// ═════════════════════════ Trade en cours ═════════════════════════
type Trade
    string id
    int    dir
    float  entry
    float  sl
    float  tp
    float  risk
    int    bar0
    string msg
    int    sess
    int    kind
    string tpTx
    bool   filled = false
    bool   be     = false
    int    tFill  = 0
    line   eLn    = na
    line   sLn    = na
    line   tLn    = na
    box    slB    = na
    box    tpB    = na
    label  eLb    = na
    label  sLb    = na
    label  tLb    = na

var Trade cur    = na
var int   seen   = 0
var int   tradeN = 0

liveR(Trade t) =>
    (close - t.entry) * t.dir / t.risk

sideLabel(int x, float y, string txt, color bg, string tip) =>
    label.new(x, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = bg,
         textcolor = color.white, size = size.small, tooltip = tip)

dropLabels(Trade t) =>
    if not na(t.eLb)
        label.delete(t.eLb)
    if not na(t.sLb)
        label.delete(t.sLb)
    if not na(t.tLb)
        label.delete(t.tLb)
    t.eLb := na
    t.sLb := na
    t.tLb := na
    true

moveRight(Trade t, int x2) =>
    if not na(t.eLn)
        t.eLn.set_x2(x2)
    if not na(t.sLn)
        t.sLn.set_x2(x2)
    if not na(t.tLn)
        t.tLn.set_x2(x2)
    if not na(t.slB)
        t.slB.set_right(x2)
    if not na(t.tpB)
        t.tpB.set_right(x2)
    if not na(t.eLb)
        t.eLb.set_x(x2)
    if not na(t.sLb)
        t.sLb.set_x(x2)
    if not na(t.tLb)
        t.tLb.set_x(x2)
    true

drawPending(Trade t) =>
    if showTrades
        int   x2 = time + FUT
        color dc = t.dir == 1 ? C_UP : C_DN
        t.eLn := line.new(time, t.entry, x2, t.entry, xloc = xloc.bar_time, color = dc, style = line.style_dashed, width = 2)
        t.sLn := line.new(time, t.sl, x2, t.sl, xloc = xloc.bar_time, color = color.new(C_DN, 20), style = line.style_dotted, width = 1)
        t.tLn := line.new(time, t.tp, x2, t.tp, xloc = xloc.bar_time, color = color.new(C_UP, 20), style = line.style_dotted, width = 1)
        t.eLb := sideLabel(x2, t.entry, (t.dir == 1 ? "Achat" : "Vente") + " limite · " + fmt(t.entry), color.new(dc, 10), t.msg)
        t.sLb := sideLabel(x2, t.sl, "SL · " + fmt(t.sl), color.new(C_DN, 35), "Stop : au-delà de la mèche du sweep")
        t.tLb := sideLabel(x2, t.tp, "TP · " + fmt(t.tp) + " · " + t.tpTx, color.new(C_UP, 35), "Objectif")
    true

drawOpen(Trade t) =>
    if showTrades
        int   x2 = time + FUT
        color dc = t.dir == 1 ? C_UP : C_DN
        dropLabels(t)
        if not na(t.sLn)
            line.delete(t.sLn)
        if not na(t.tLn)
            line.delete(t.tLn)
        t.sLn := na
        t.tLn := na
        t.slB := box.new(t.tFill, math.max(t.entry, t.sl), x2, math.min(t.entry, t.sl), xloc = xloc.bar_time,
             bgcolor = color.new(C_DN, 78), border_color = color.new(C_DN, 40), border_width = 1)
        t.tpB := box.new(t.tFill, math.max(t.entry, t.tp), x2, math.min(t.entry, t.tp), xloc = xloc.bar_time,
             bgcolor = color.new(C_UP, 78), border_color = color.new(C_UP, 40), border_width = 1)
        if na(t.eLn)
            t.eLn := line.new(t.tFill, t.entry, x2, t.entry, xloc = xloc.bar_time, color = dc, width = 2)
        else
            t.eLn.set_xy1(t.tFill, t.entry)
            t.eLn.set_y2(t.entry)
            t.eLn.set_style(line.style_solid)
        label.new(t.tFill, t.entry, t.dir == 1 ? "▲" : "▼", xloc = xloc.bar_time, color = color(na),
             style = t.dir == 1 ? label.style_label_up : label.style_label_down,
             textcolor = dc, size = size.normal, tooltip = t.msg)
        t.eLb := sideLabel(x2, t.entry, t.id + " · " + fmt(t.entry), color.new(dc, 10), t.msg)
        t.sLb := sideLabel(x2, t.sl, "SL · " + fmt(t.sl) + " · -1R", color.new(C_DN, 35), "Stop")
        t.tLb := sideLabel(x2, t.tp, "TP · " + fmt(t.tp) + " · " + t.tpTx, color.new(C_UP, 35), "Objectif")
    true

updateLive(Trade t) =>
    if not na(t.eLb)
        float r = liveR(t)
        t.eLb.set_text(t.id + " · " + fmt(t.entry) + " · " + rTxt(r) + (t.be ? " · stop à l'entrée" : ""))
        t.eLb.set_color(color.new(r >= 0 ? C_UP : C_DN, 10))
    true

finish(Trade t, int xe, float px, string why) =>
    dropLabels(t)
    moveRight(t, xe)
    if showTrades
        float r = (px - t.entry) * t.dir / t.risk
        label.new(xe, px, why + " " + rTxt(r), xloc = xloc.bar_time, style = label.style_label_left,
             color = color.new(r >= 0 ? C_UP : C_DN, 15), textcolor = color.white, size = size.small,
             tooltip = t.id + " · entrée " + fmt(t.entry) + " · sortie " + fmt(px))
    true

cancelDraw(Trade t, string why) =>
    dropLabels(t)
    moveRight(t, time)
    if not na(t.eLn)
        t.eLn.set_color(color.new(C_SL, 40))
        t.eLn.set_width(1)
    if not na(t.sLn)
        line.delete(t.sLn)
    if not na(t.tLn)
        line.delete(t.tLn)
    if showTrades
        label.new(time, t.entry, "Annulé", xloc = xloc.bar_time, style = label.style_label_left, color = color(na),
             textcolor = color.new(C_SL, 20), size = size.tiny, tooltip = "Ordre limite annulé : " + why)
    true

if not na(cur)
    if strategy.closedtrades > seen
        // Trade clôturé (éventuellement exécuté et clôturé sur la même bougie)
        int k = strategy.closedtrades - 1
        if not cur.filled
            cur.filled := true
            nFilled    += 1
            cur.tFill  := strategy.closedtrades.entry_time(k)
            cur.entry  := strategy.closedtrades.entry_price(k)
            cur.risk   := math.abs(cur.entry - cur.sl)
            drawOpen(cur)
        float px = strategy.closedtrades.exit_price(k)
        float rr = (px - cur.entry) * cur.dir / cur.risk
        nClosed += 1
        sumR    += rr
        if rr > 0.1
            winR   += rr
            nPos   += 1
            streak := 0
        else if rr < -0.1
            lossR  -= rr
            streak += 1
        worstSt := math.max(worstSt, streak)
        peakR   := math.max(peakR, sumR)
        ddR     := math.max(ddR, peakR - sumR)
        sN.set(cur.sess, sN.get(cur.sess) + 1)
        sR.set(cur.sess, sR.get(cur.sess) + rr)
        kN.set(cur.kind, kN.get(cur.kind) + 1)
        kR.set(cur.kind, kR.get(cur.kind) + rr)
        if firstTr == 0
            firstTr := strategy.closedtrades.entry_time(k)
        lastTr := strategy.closedtrades.exit_time(k)
        finish(cur, strategy.closedtrades.exit_time(k), px, strategy.closedtrades.exit_comment(k))
        if rr < -0.1
            lossToday += 1
        alert(tgPayload(syminfo.ticker + " · " + cur.id + " clôturé (" + strategy.closedtrades.exit_comment(k) + ") : " +
             rTxt(rr) + " à " + fmt(px)), alert.freq_once_per_bar_close)
        cur := na
    else if not cur.filled and strategy.position_size != 0
        cur.filled := true
        nFilled    += 1
        cur.tFill  := strategy.opentrades.entry_time(0)
        cur.entry  := strategy.opentrades.entry_price(0)
        cur.risk   := math.abs(cur.entry - cur.sl)
        drawOpen(cur)
        updateLive(cur)
        alert(tgPayload(syminfo.ticker + " · " + cur.id + " exécuté à " + fmt(cur.entry)), alert.freq_once_per_bar_close)
    else if not cur.filled
        if bar_index > cur.bar0
            bool missed  = cur.dir == 1 ? high >= cur.tp : low <= cur.tp
            bool expired = bar_index - cur.bar0 >= limitBars or not inKZ or inFlat
            if missed or expired
                if missed
                    cMiss += 1
                else
                    cExp += 1
                strategy.cancel(cur.id)
                strategy.cancel("X " + cur.id)
                string why = missed ? "objectif atteint sans exécution" : not inKZ ? "fin de la kill zone" : "délai dépassé"
                cancelDraw(cur, why)
                alert(tgPayload(syminfo.ticker + " · " + cur.id + " : ordre limite annulé (" + why + ")"), alert.freq_once_per_bar_close)
                cur := na
            else
                moveRight(cur, time + FUT)
    else
        // Trade ouvert : stop au prix d'entrée une fois le seuil atteint
        if beR > 0 and not cur.be and (cur.dir == 1 ? high >= cur.entry + beR * cur.risk : low <= cur.entry - beR * cur.risk)
            cur.be := true
            strategy.exit("X " + cur.id, from_entry = cur.id, stop = cur.entry, limit = cur.tp, comment_profit = "TP", comment_loss = "BE")
            if not na(cur.slB)
                cur.slB.set_bgcolor(color.new(C_SL, 80))
            alert(tgPayload(syminfo.ticker + " · " + cur.id + " : stop déplacé au prix d'entrée (" + fmt(cur.entry) + ")"), alert.freq_once_per_bar_close)
        moveRight(cur, time + FUT)
        updateLive(cur)
seen := strategy.closedtrades

// Fermeture de fin de journée
if inFlat and strategy.position_size != 0
    strategy.close_all(comment = "Fin de journée")

// ═════════════════════════ Poches prises → sweeps ═════════════════════════
if pools.size() > 0
    for i = 0 to pools.size() - 1
        Pool p = pools.get(i)
        if not p.used
            if not na(p.plvl) and not p.ptaken and (p.dir == -1 ? pH > p.plvl : pL < p.plvl)
                p.ptaken := true
            bool hit  = p.dir == -1 ? high > p.lvl : low < p.lvl
            bool live = inKZ and not inFlat
            if hit and (live or consumeOut)
                p.used := true
                if not na(p.ln)
                    p.ln.set_x2(time)
                int side = p.dir == -1 ? 0 : 1
                if live
                    cSweep += 1
                    if not stOn.get(side)
                        stOn.set(side, true)
                        stExt.set(side, p.dir == -1 ? high : low)
                        stLvl.set(side, p.lvl)
                        stBar.set(side, bar_index)
                        stPool.set(side, i)
                        stName.set(side, p.name)
                        stChoch.set(side, p.dir == -1 ? lastSwL : lastSwH)
                    else
                        // Plusieurs poches prises dans le même mouvement : on garde la plus éloignée
                        if p.dir == -1 ? p.lvl > stLvl.get(side) : p.lvl < stLvl.get(side)
                            stLvl.set(side, p.lvl)
                            stPool.set(side, i)
                        stName.set(side, stName.get(side) + " + " + p.name)
                else
                    // Prise hors kill zone : la liquidité est consommée, pas de trade
                    cOut += 1
            else if not na(p.ln) and not inFlat
                p.ln.set_x2(time)

// ═════════════════════════ Confirmation : CHoCH M5 ou reclôture ═════════════════════════
int    sigDir  = 0
float  sigExt  = na
int    sigPool = -1
string sigName = ""

for s = 0 to 1
    if stOn.get(s)
        int   d   = s == 0 ? -1 : 1
        float lvl = stLvl.get(s)
        if not inKZ or inFlat
            stOn.set(s, false)
            cKzEnd += 1
        else
            // Nouvel extrême : le swing à casser devient le dernier swing opposé
            if bar_index > stBar.get(s) and (d == -1 ? high > stExt.get(s) : low < stExt.get(s))
                stExt.set(s, d == -1 ? high : low)
                stChoch.set(s, d == -1 ? lastSwL : lastSwH)
            float ch   = nz(stChoch.get(s), lvl)
            float ref  = confMode == C_CHOCH ? (d == -1 ? math.min(lvl, ch) : math.max(lvl, ch)) : lvl
            bool  brk  = d == -1 ? close < ref : close > ref
            bool  disp = dispMin <= 0 or (close - open) * d >= dispMin * atr5
            if brk and disp and sigDir == 0
                sigDir  := d
                sigExt  := stExt.get(s)
                sigPool := stPool.get(s)
                sigName := stName.get(s)
                stOn.set(s, false)
            else if bar_index - stBar.get(s) >= confMax
                stOn.set(s, false)
                cNoConf += 1
                markReject(d, "Sweep " + stName.get(s) + " sans confirmation en " + str.tostring(confMax) + " bougies : " +
                     (brk ? "cassure sans déplacement suffisant" : confMode == C_CHOCH ? "pas de changement de structure" : "pas de reclôture"))

// ═════════════════════════ Filtres, stop, objectif, ordre ═════════════════════════
if sigDir != 0
    cSig += 1
    Pool   sp     = pools.get(sigPool)
    bool   smtOk  = not useSMT or not smtAvail or not sp.ptaken
    bool   biasOk = biasSrc == B_NONE or (biasNow == 0 ? neutralMode == N_BOTH : biasUse == U_WITH ? biasNow == sigDir : biasNow == -sigDir)
    float  midC   = (open + close) / 2
    float  fvg    = sigDir == -1 ? fvgDn : fvgUp
    bool   useFvg = entryMode == E_FVG and not na(fvg)
    bool   isLim  = entryMode != E_CLOSE
    float  ent    = entryMode == E_CLOSE ? close : useFvg ? fvg : midC
    float  eq     = (day.hi + day.lo) / 2
    bool   pdOk   = not pdFilter or na(eq) or (sigDir == -1 ? ent > eq : ent < eq)
    bool   free   = na(cur) and strategy.position_size == 0 and nToday < maxTrades and lossToday < maxLoss
    string what   = "Sweep " + sigName
    if not smtOk
        cSmt += 1
        markReject(sigDir, what + " sans divergence SMT : l'actif corrélé (" + peerSym + ") a aussi pris ce niveau")
    else if not biasOk
        cBias += 1
        markReject(sigDir, what + " écarté par le biais (" + biasTxt(biasNow) + ")")
    else if not pdOk
        cPD += 1
        markReject(sigDir, what + " : entrée " + (sigDir == -1 ? "en discount (vente trop basse)" : "en premium (achat trop haut)") + ", milieu du range du jour à " + fmt(eq))
    else if not free
        cBusy += 1
        markReject(sigDir, what + " : trade en cours ou limite du jour atteinte")
    else
        float slPx = sigExt - sigDir * slBuf * atr5
        float dist = math.abs(ent - slPx)
        if dist < minStop * atr5
            slPx := ent - sigDir * minStop * atr5
            dist := minStop * atr5
        slPx := slPx - sigDir * padPx
        dist := dist + padPx
        float  tp   = ent + sigDir * rrT * dist
        string tpTx = str.tostring(rrT, "0.0#") + "R"
        if tgtMode == T_LIQ
            float  best  = na
            float  bestR = na
            string bName = ""
            for i = 0 to pools.size() - 1
                Pool q = pools.get(i)
                if not q.used and q.dir == -sigDir
                    float rq = (q.lvl - ent) * sigDir / dist
                    if rq >= rrMin and (na(bestR) or rq < bestR)
                        best  := q.lvl
                        bestR := rq
                        bName := q.name
            if not na(best)
                float rUse = math.min(bestR, rrMax)
                tp   := ent + sigDir * rUse * dist
                tpTx := (bestR > rrMax ? "plafond avant " : "") + bName + " · " + str.tostring(rUse, "0.0") + "R"
        float qty = math.floor((strategy.initial_capital + strategy.netprofit) * riskPct / 100 / (dist * syminfo.pointvalue * fx) / qtyStep) * qtyStep
        if na(qty) or qty <= 0
            markReject(sigDir, isFut ? "Moins d'un contrat : passer sur le micro (MNQ, MES, MGC…) ou augmenter le risque" : "Quantité nulle : réduire le pas de taille ou augmenter le risque")
        else
            cOrder += 1
            nToday += 1
            tradeN += 1
            string id = (sigDir == 1 ? "Achat #" : "Vente #") + str.tostring(tradeN)
            if isLim
                strategy.entry(id, sigDir == 1 ? strategy.long : strategy.short, qty = qty, limit = ent, comment = what)
            else
                strategy.entry(id, sigDir == 1 ? strategy.long : strategy.short, qty = qty, comment = what)
            strategy.exit("X " + id, from_entry = id, stop = slPx, limit = tp, comment_profit = "TP", comment_loss = "SL")
            string msg = syminfo.ticker + " · " + (sigDir == 1 ? "ACHAT" : "VENTE") + (isLim ? " (ordre limite)" : " (au marché)") +
                 "\n" + str.format_time(time, "dd/MM HH:mm", TZ_PARIS) + " (Paris) · " + sessName(sessNow) +
                 "\nSetup : sweep " + sigName + " (" + fmt(sp.lvl) + ") puis " + (confMode == C_CHOCH ? "changement de structure M5" : "reclôture") + (useSMT ? " + SMT" : "") +
                 "\nBiais : " + biasTxt(biasNow) + (biasSrc == B_NONE ? " (non filtré)" : "") +
                 "\nEntrée : " + fmt(ent) + (entryMode == E_CLOSE ? " (clôture)" : useFvg ? " (milieu du FVG)" : " (milieu de la bougie)") +
                 "\nStop : " + fmt(slPx) + " (" + distTxt(dist) + " = 1R" + (padPx > 0 ? ", dont " + distTxt(padPx) + " de marge" : "") + ")" +
                 "\nObjectif : " + fmt(tp) + " (" + tpTx + ")" +
                 "\nRisque : " + str.tostring(riskPct) + " % · " + str.tostring(qty) + (isFut ? " contrat(s)" : "") +
                 " · " + str.tostring(qty * dist * syminfo.pointvalue * fx, "0.##") + " $ risqués" +
                 (isLim ? "\nValable " + str.tostring(limitBars * 5) + " min, jusqu'à la fin de la kill zone au plus tard" : "")
            cur := Trade.new(id = id, dir = sigDir, entry = ent, sl = slPx, tp = tp, risk = dist, bar0 = bar_index, msg = msg, sess = sessNow, kind = sp.kind, tpTx = tpTx)
            if isLim
                drawPending(cur)
            if showSetup
                label.new(time, sigExt, what, xloc = xloc.bar_time, color = color(na),
                     style = sigDir == 1 ? label.style_label_up : label.style_label_down,
                     textcolor = color.new(sigDir == 1 ? C_UP : C_DN, 10), size = size.small,
                     tooltip = "Liquidité " + sigName + " prise puis " + (confMode == C_CHOCH ? "changement de structure M5" : "reclôture"))
            alert(tgPayload(msg), alert.freq_once_per_bar_close)

// ═════════════════════════ Tableaux ═════════════════════════
cellRow(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(chart.fg_color, 40), text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

biasColor(int b) =>
    b == 1 ? C_UP : b == -1 ? C_DN : chart.fg_color

var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.gray, 90), border_width = 0, frame_width = 0)
if showTable and barstate.islast
    color fg = chart.fg_color
    cellRow(tb, 0, "Biais du jour", biasTxt(biasNow) + (biasSrc == B_NONE ? " (pas de filtre)" : " · " + (biasUse == U_WITH ? "dans le sens" : "contre")), biasColor(biasNow))
    cellRow(tb, 1, "Journalier", biasTxt(dBias) + " : " + dWhy, biasColor(dBias))
    cellRow(tb, 2, "H4 figé · H1 en direct", biasTxt(h4Day) + " · " + biasTxt(h1Now), fg)
    string act = ""
    if pools.size() > 0
        for i = 0 to pools.size() - 1
            Pool q = pools.get(i)
            if not q.used
                act += (act == "" ? "" : " · ") + q.name
    cellRow(tb, 3, "Poches intactes", act == "" ? "aucune" : act, C_ASIA)
    string st = not na(cur) and cur.filled ? cur.id + " ouvert" :
         not na(cur) ? "Ordre limite en attente" :
         inAsia ? "Accumulation : range asiatique en cours" :
         stOn.get(0) ? "Sweep " + stName.get(0) + " → attente de la confirmation" :
         stOn.get(1) ? "Sweep " + stName.get(1) + " → attente de la confirmation" :
         nToday >= maxTrades or lossToday >= maxLoss ? "Limite du jour atteinte" :
         not inKZ ? "Hors kill zone" : "Attente d'un sweep"
    cellRow(tb, 4, "État", st, fg)
    float  lr    = not na(cur) and cur.filled ? liveR(cur) : na
    string posTx = na(cur) ? "Aucune" : cur.filled ? cur.id + " · " + rTxt(lr) : (cur.dir == 1 ? "Achat" : "Vente") + " limite à " + fmt(cur.entry)
    color  posC  = na(cur) ? fg : cur.filled ? (lr >= 0 ? C_UP : C_DN) : (cur.dir == 1 ? C_UP : C_DN)
    cellRow(tb, 5, "Position", posTx, posC)
    cellRow(tb, 6, "Aujourd'hui", str.tostring(nToday) + " / " + str.tostring(maxTrades) + " trades · " + str.tostring(lossToday) + " / " + str.tostring(maxLoss) + " perte(s)", fg)

var table dg = table.new(position.bottom_right, 2, 12, bgcolor = color.new(color.gray, 90), border_width = 0, frame_width = 0)
if showDiag and barstate.islast
    color fg  = chart.fg_color
    color bad = color.new(C_DN, 20)
    cellRow(dg, 0, "Poches prises en kill zone", str.tostring(cSweep), fg)
    cellRow(dg, 1, "Poches consommées hors kill zone", str.tostring(cOut), color.new(fg, 40))
    cellRow(dg, 2, "✗ Pas de confirmation (vraie cassure)", str.tostring(cNoConf), bad)
    cellRow(dg, 3, "✗ Fin de kill zone avant confirmation", str.tostring(cKzEnd), bad)
    cellRow(dg, 4, "Sweeps confirmés (signaux)", str.tostring(cSig), fg)
    cellRow(dg, 5, "✗ Écartés : pas de SMT", str.tostring(cSmt), bad)
    cellRow(dg, 6, "✗ Écartés : biais", str.tostring(cBias), bad)
    cellRow(dg, 7, "✗ Écartés : premium / discount", str.tostring(cPD), bad)
    cellRow(dg, 8, "✗ Écartés : trade en cours / limite", str.tostring(cBusy), bad)
    cellRow(dg, 9, "Ordres placés", str.tostring(cOrder), fg)
    cellRow(dg, 10, "✗ Annulés : cible / délai", str.tostring(cMiss) + " / " + str.tostring(cExp), bad)
    cellRow(dg, 11, "Exécutés · gagnants", str.tostring(nFilled) + " · " + str.tostring(nPos), C_UP)

var table stt = table.new(position.bottom_left, 2, 16, bgcolor = color.new(color.gray, 90), border_width = 0, frame_width = 0)
if showStats and barstate.islast
    color  fg    = chart.fg_color
    float  wr    = nClosed > 0 ? 100.0 * nPos / nClosed : na
    float  exR   = nClosed > 0 ? sumR / nClosed : na
    float  pf    = lossR > 0 ? winR / lossR : na
    bool   few   = nClosed < 30
    string smtTx = useSMT ? (smtAvail ? " · SMT " + peerSym : " · SMT indisponible") : ""
    cellRow(stt, 0, "Marché", syminfo.ticker + " (" + syminfo.type + ")" + smtTx + (padPx > 0 ? " · marge SL " + distTxt(padPx) : ""), C_ASIA)
    cellRow(stt, 1, "Période", nClosed == 0 ? "—" : str.format_time(firstTr, "dd/MM/yy", TZ_PARIS) + " → " + str.format_time(lastTr, "dd/MM/yy", TZ_PARIS) + " · " + str.tostring(nDays) + " jours", fg)
    cellRow(stt, 2, "Trades · gagnants", str.tostring(nClosed) + " · " + (na(wr) ? "—" : str.tostring(wr, "0") + " %") + (nDays > 0 ? " · " + str.tostring(nClosed / nDays, "0.0") + " / jour" : ""), fg)
    cellRow(stt, 3, "Espérance", na(exR) ? "—" : (exR >= 0 ? "+" : "") + str.tostring(exR, "0.00") + "R / trade", na(exR) ? fg : exR >= 0 ? C_UP : C_DN)
    cellRow(stt, 4, "Profit factor", na(pf) ? (winR > 0 ? "∞" : "—") : str.tostring(pf, "0.00"), na(pf) ? fg : pf >= 1 ? C_UP : C_DN)
    cellRow(stt, 5, "Total", rTxt(sumR), sumR >= 0 ? C_UP : C_DN)
    cellRow(stt, 6, "Max drawdown · pire série", "-" + str.tostring(ddR, "0.0") + "R · " + str.tostring(worstSt) + " perte(s)", C_DN)
    for j = 0 to 2
        cellRow(stt, 7 + j, sessName(j), nrTxt(sN.get(j), sR.get(j)), sN.get(j) == 0 ? fg : sR.get(j) >= 0 ? C_UP : C_DN)
    for j = 0 to 3
        cellRow(stt, 10 + j, kindName(j), nrTxt(kN.get(j), kR.get(j)), kN.get(j) == 0 ? fg : kR.get(j) >= 0 ? C_UP : C_DN)
    cellRow(stt, 14, "Biais testé", biasSrc + (biasSrc == B_NONE ? "" : " · " + biasUse), fg)
    cellRow(stt, 15, "Fiabilité", nClosed == 0 ? "Aucun trade" : few ? "Échantillon faible (< 30 trades)" : nClosed < 100 ? "Indicatif (30 à 100 trades)" : "Correct (100 trades et plus)", few ? C_DN : fg)
