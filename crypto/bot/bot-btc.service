# Service systemd (Linux / VPS). À copier dans /etc/systemd/system/bot-btc.service, puis :
#   sudo systemctl daemon-reload && sudo systemctl enable --now bot-btc
#   journalctl -u bot-btc -f            (suivre le journal)
# Les clés vont dans /etc/bot-btc.env (chmod 600) : BINANCE_API_KEY=..., BINANCE_API_SECRET=..., TELEGRAM_TOKEN=...,
# TELEGRAM_CHAT_ID=..., et BOT_REEL_CONFIRME=oui seulement pour le mode réel.
[Unit]
Description=Bot BTC (confluence multi-unites)
After=network-online.target

[Service]
WorkingDirectory=/opt/Bot-Trading
EnvironmentFile=/etc/bot-btc.env
ExecStart=/usr/bin/python3 crypto/bot/bot.py --config crypto/bot/config.json
Restart=always
RestartSec=60
User=bot

[Install]
WantedBy=multi-user.target
